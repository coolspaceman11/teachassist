{
  "expo": {
    "name": "TeachAssist+",
    "slug": "teachassist-plus",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/playstore-icon-transparent.png",
    "scheme": "teachassistplus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teachassistplus.studentapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/images/teachassist-ios-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/playstore-icon-transparent.png",
        "backgroundColor": "#161616"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.teachassistplus.studentapp"
    },
    "notification": {
      "icon": "./assets/images/teach-icon-transparent.png",
      "color": "#27b1fa"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/teach-icon-transparent.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/teach-icon-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#161616"
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-background-task",
      "expo-video",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
